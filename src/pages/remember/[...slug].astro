---
import Layout from '../../layouts/BlogPost.astro';
import FlamzaSystem from '../../components/FlamzaSystem.astro';

export async function getStaticPaths() {
    return [
        { params: { slug: 'privacy' }, props: { title: 'Privacy Policy' } },
        { params: { slug: 'tos' }, props: { title: 'Terms of Service' } },
    ];
}

const { title } = Astro.props;
---

<Layout
	title={title}
	description="..."
	pubDate={new Date('March 17 2026')}
>
    <FlamzaSystem />
    <div class="content-container">
        <h2>{title}</h2>
        <p>This is the {title} for the Land of Flamza.</p>
        <p>Everything here is part of the joke and has no legal standing.</p>
    </div>
</Layout>

<style>
    .content-container {
        min-height: 400px;
        color: var(--orange-accent);
        padding: 2rem;
        border: 1px dashed var(--orange-accent);
        margin-top: 2rem;
    }
    h2 {
        color: var(--orange-accent);
        text-transform: uppercase;
        margin-bottom: 2rem;
    }
    p {
        margin-bottom: 1rem;
    }
</style>
