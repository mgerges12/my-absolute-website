---
import Layout from '../layouts/BlogPost.astro';

// Minesweeper implementation in the "secret" page
---

<Layout
	title="Minesweeper"
	description="A game of risk and reward."
	pubDate={new Date('March 17 2026')}
>
    <!-- Force standard cursor for this page specifically -->
    <style is:global>
        html, body, main, article {
            cursor: default !important;
        }
        button, a, .cell {
            cursor: pointer !important;
        }
        .board {
            cursor: crosshair !important;
        }
        .cell.revealed {
            cursor: default !important;
        }
    </style>

    <div class="minesweeper-container">
        <div class="difficulty-selector">
            <button class="diff-btn active" data-level="easy">Easy</button>
            <button class="diff-btn" data-level="medium">Medium</button>
            <button class="diff-btn" data-level="hard">Hard</button>
        </div>

        <div id="status-bar">
            <div class="status-item">💣 <span id="mine-count">10</span></div>
            <button id="reset-btn">Reset</button>
            <div class="status-item">⏱️ <span id="timer">0</span></div>
        </div>
        
        <div id="game-board-wrapper">
            <div id="game-board" class="board"></div>
        </div>
        
        <div id="message" class="message"></div>

        <div class="controls-hint">
            <p>Left Click: Reveal | Right Click: Flag</p>
        </div>
    </div>

    <style>
        .minesweeper-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 1rem;
            font-family: 'Courier New', Courier, monospace;
            user-select: none;
            color: #eee;
            width: 100%;
        }

        .difficulty-selector {
            margin-bottom: 1rem;
            display: flex;
            gap: 10px;
        }

        .diff-btn {
            background: #222;
            color: #888;
            border: 2px solid #444;
            padding: 8px 16px;
            border-radius: 4px;
            font-family: inherit;
            font-weight: bold;
            transition: all 0.2s;
        }

        .diff-btn.active {
            background: #0f0;
            color: #000;
            border-color: #0f0;
            box-shadow: 0 0 15px rgba(0, 255, 0, 0.4);
        }

        #status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 450px;
            padding: 15px 25px;
            background: #000;
            color: #0f0;
            border: 3px solid #0f0;
            margin-bottom: 1.5rem;
            border-radius: 8px;
            box-sizing: border-box;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.2);
        }

        .status-item {
            font-weight: bold;
            font-size: 1.6rem;
            min-width: 90px;
        }

        #reset-btn {
            background: #333;
            color: #0f0;
            border: 2px solid #0f0;
            padding: 8px 20px;
            font-family: inherit;
            border-radius: 4px;
            font-weight: bold;
            text-transform: uppercase;
            box-shadow: inset 0 0 5px rgba(0, 255, 0, 0.2);
        }

        #reset-btn:hover {
            background: #0f0;
            color: #000;
        }

        #game-board-wrapper {
            background: #333;
            padding: 10px;
            border-radius: 4px;
            border: 2px solid #555;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            display: flex;
            justify-content: center;
        }

        .board {
            display: grid;
            background: #888; 
            gap: 1px;
            border: 1px solid #888;
            padding: 0;
            margin: 0;
            width: max-content;
            box-sizing: content-box;
        }

        .cell {
            width: 32px;
            height: 32px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 1.2rem;
            box-sizing: border-box;
            position: relative;
            user-select: none;
        }

        /* Unrevealed cell */
        .cell:not(.revealed) {
            background: #bdbdbd;
            box-shadow: inset 3px 3px #eee, inset -3px -3px #7b7b7b;
        }

        .cell:not(.revealed):active {
            box-shadow: inset 1px 1px #7b7b7b;
            background: #aaa;
        }

        /* Revealed cell */
        .cell.revealed {
            background: #ddd;
            box-shadow: inset 1px 1px #7b7b7b;
        }

        .cell.mine {
            background: #ff4d4d !important;
            box-shadow: none;
        }

        .cell.flagged::after {
            content: "🚩";
            font-size: 1.2rem;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            pointer-events: none;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
        }

        .message {
            margin-top: 1.5rem;
            font-size: 2.2rem;
            font-weight: bold;
            height: 3rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            text-align: center;
        }

        .win { color: #0f0; text-shadow: 0 0 15px #0f0; }
        .lose { color: #f44; text-shadow: 0 0 15px #f44; }

        .controls-hint {
            margin-top: 1.5rem;
            font-size: 0.9rem;
            opacity: 0.8;
            text-align: center;
            background: rgba(0,255,0,0.1);
            color: #0f0;
            padding: 12px 25px;
            border: 1px solid rgba(0,255,0,0.3);
            border-radius: 25px;
        }

        /* Number colors */
        .n1 { color: #0000ff; }
        .n2 { color: #008000; }
        .n3 { color: #ff0000; }
        .n4 { color: #000080; }
        .n5 { color: #800000; }
        .n6 { color: #008080; }
        .n7 { color: #000000; }
        .n8 { color: #808080; }

        /* Light mode adjustments */
        :global(.light-mode) .minesweeper-container {
            color: #333;
        }
        :global(.light-mode) #status-bar {
            background: #eee;
            color: #008000;
            border-color: #008000;
            box-shadow: none;
        }
        :global(.light-mode) #reset-btn {
            color: #008000;
            border-color: #008000;
            background: #fff;
        }
        :global(.light-mode) #reset-btn:hover {
            background: #008000;
            color: #fff;
        }
        :global(.light-mode) .controls-hint {
            background: rgba(0,128,0,0.05);
            color: #008000;
            border-color: rgba(0,128,0,0.2);
        }
        :global(.light-mode) #game-board-wrapper {
            background: #eee;
            border-color: #ccc;
        }
    </style>

    <script>
        const DIFFICULTIES = {
            easy: { rows: 9, cols: 9, mines: 10 },
            medium: { rows: 16, cols: 16, mines: 40 },
            hard: { rows: 24, cols: 24, mines: 99 }
        };

        let currentLevel = 'easy';
        let rows = DIFFICULTIES.easy.rows;
        let cols = DIFFICULTIES.easy.cols;
        let mines = DIFFICULTIES.easy.mines;
        
        let board = [];
        let revealedCount = 0;
        let gameOver = false;
        let timerInterval = null;
        let seconds = 0;
        let minesFlagged = 0;

        const boardElement = document.getElementById('game-board');
        const messageElement = document.getElementById('message');
        const mineCountElement = document.getElementById('mine-count');
        const timerElement = document.getElementById('timer');
        const resetBtn = document.getElementById('reset-btn');
        const diffButtons = document.querySelectorAll('.diff-btn');

        function initGame() {
            gameOver = false;
            revealedCount = 0;
            minesFlagged = 0;
            seconds = 0;
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = null;
            timerElement.textContent = '0';
            mineCountElement.textContent = mines;
            messageElement.textContent = '';
            messageElement.className = 'message';
            
            boardElement.style.gridTemplateColumns = `repeat(${cols}, 32px)`;
            boardElement.style.gridTemplateRows = `repeat(${rows}, 32px)`;
            
            createBoard();
            renderBoard();
        }

        function createBoard() {
            board = [];
            for (let r = 0; r < rows; r++) {
                board[r] = [];
                for (let c = 0; c < cols; c++) {
                    board[r][c] = {
                        isMine: false,
                        isRevealed: false,
                        isFlagged: false,
                        neighborMines: 0,
                        r, c
                    };
                }
            }

            let minesPlaced = 0;
            while (minesPlaced < mines) {
                let r = Math.floor(Math.random() * rows);
                let c = Math.floor(Math.random() * cols);
                if (!board[r][c].isMine) {
                    board[r][c].isMine = true;
                    minesPlaced++;
                }
            }

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    if (board[r][c].isMine) continue;
                    let count = 0;
                    for (let dr = -1; dr <= 1; dr++) {
                        for (let dc = -1; dc <= 1; dc++) {
                            let nr = r + dr;
                            let nc = c + dc;
                            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && board[nr][nc].isMine) {
                                count++;
                            }
                        }
                    }
                    board[r][c].neighborMines = count;
                }
            }
        }

        function renderBoard() {
            boardElement.innerHTML = '';
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cellDiv = document.createElement('div');
                    cellDiv.classList.add('cell');
                    cellDiv.dataset.r = r;
                    cellDiv.dataset.c = c;
                    
                    // Standard Left Click
                    cellDiv.addEventListener('click', (e) => {
                        if (gameOver) return;
                        handleCellClick(r, c, cellDiv);
                    });
                    
                    // Standard Right Click (Context Menu)
                    cellDiv.addEventListener('contextmenu', (e) => {
                        e.preventDefault();
                        if (gameOver) return;
                        handleRightClick(r, c, cellDiv);
                    });
                    
                    boardElement.appendChild(cellDiv);
                }
            }
        }

        function handleCellClick(r, c, element) {
            const cell = board[r][c];
            if (cell.isRevealed || cell.isFlagged) return;

            if (timerInterval === null) {
                startTimer();
            }

            if (cell.isMine) {
                revealMines();
                endGame(false);
                return;
            }

            revealCell(r, c, element);
            
            if (revealedCount === rows * cols - mines) {
                endGame(true);
            }
        }

        function handleRightClick(r, c, element) {
            const cell = board[r][c];
            if (cell.isRevealed) return;

            cell.isFlagged = !cell.isFlagged;
            
            if (cell.isFlagged) {
                element.classList.add('flagged');
                minesFlagged++;
            } else {
                element.classList.remove('flagged');
                minesFlagged--;
            }
            
            mineCountElement.textContent = mines - minesFlagged;
        }

        function revealCell(r, c, element) {
            const cell = board[r][c];
            if (cell.isRevealed || cell.isFlagged) return;

            cell.isRevealed = true;
            revealedCount++;
            
            element.classList.add('revealed');
            
            if (cell.neighborMines > 0) {
                element.textContent = cell.neighborMines;
                element.classList.add('n' + cell.neighborMines);
            } else {
                // Flood fill for empty cells
                for (let dr = -1; dr <= 1; dr++) {
                    for (let dc = -1; dc <= 1; dc++) {
                        let nr = r + dr;
                        let nc = c + dc;
                        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                            const neighborElement = boardElement.children[nr * cols + nc];
                            revealCell(nr, nc, neighborElement);
                        }
                    }
                }
            }
        }

        function revealMines() {
            const children = boardElement.children;
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    if (board[r][c].isMine) {
                        const cellDiv = children[r * cols + c];
                        cellDiv.classList.add('revealed', 'mine');
                        cellDiv.textContent = '💣';
                    }
                }
            }
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                seconds++;
                if (seconds > 999) seconds = 999;
                timerElement.textContent = seconds;
            }, 1000);
        }

        function endGame(won) {
            gameOver = true;
            if (timerInterval) clearInterval(timerInterval);
            if (won) {
                messageElement.textContent = 'Victory!';
                messageElement.classList.add('win');
            } else {
                messageElement.textContent = 'Boom!';
                messageElement.classList.add('lose');
            }
        }

        resetBtn.addEventListener('click', initGame);

        diffButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                diffButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                currentLevel = btn.dataset.level;
                rows = DIFFICULTIES[currentLevel].rows;
                cols = DIFFICULTIES[currentLevel].cols;
                mines = DIFFICULTIES[currentLevel].mines;
                
                initGame();
            });
        });

        initGame();
    </script>
</Layout>
